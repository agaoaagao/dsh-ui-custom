{
  "name": "dsh-ui-custom",
  "version": "0.1.0",
  "description": "系统外观 (branding) for any DeepSeek Harness: system name, logo or text badge, tab icon, conversation headline and running label, all from one Settings section. · 任意 dsh 都可用的系统外观插件。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agaoaagao/dsh-ui-custom.git"
  },
  "homepage": "https://github.com/agaoaagao/dsh-ui-custom#readme",
  "bugs": {
    "url": "https://github.com/agaoaagao/dsh-ui-custom/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/config.js": "./lib/config.js",
    "./lib/store.js": "./lib/store.js",
    "./lib/http.js": "./lib/http.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "branding",
    "white-label",
    "ui-custom"
  ],
  "author": "ColaCao",
  "license": "MIT"
}
